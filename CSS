:root {
  --bg: #f5efe7;
  --bg-alt: #eef4f8;
  --surface: #ffffff;
  --surface-soft: #fffaf6;
  --primary: #1e3a5f;
  --secondary: #2f6f8f;
  --accent: #f28c62;
  --accent-soft: #f9d7b7;
  --highlight: #f5c96a;
  --text: #1f2933;
  --muted: #5b6472;
  --border: rgba(30, 58, 95, 0.12);
  --shadow: 0 20px 40px rgba(25, 41, 58, 0.12);
  --space-1: 8px;
  --space-2: 16px;
  --space-3: 24px;
  --space-4: 32px;
  --space-5: 40px;
  --space-6: 48px;
  --space-7: 56px;
  --space-8: 64px;
  --radius-sm: 12px;
  --radius-md: 20px;
  --radius-lg: 28px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Inter", Arial, sans-serif;
  background: linear-gradient(135deg, var(--bg) 0%, var(--bg-alt) 100%);
  color: var(--text);
}

img {
  max-width: 100%;
  display: block;
}

p {
  margin: 0 0 var(--space-2);
  line-height: 1.7;
  font-size: 1.05rem;
}

h1,
h2,
h3,
.site-header .brand-wrap h1 {
  margin: 0 0 var(--space-2);
  font-family: "Playfair Display", Georgia, serif;
  line-height: 1.1;
  color: var(--primary);
}

h1 {
  font-size: clamp(2.4rem, 5vw, 3.3rem);
}

h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.04em;
}

h3 {
  font-size: clamp(1.3rem, 2vw, 1.8rem);
}

a {
  color: inherit;
  text-decoration: none;
}

.page-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--space-4) var(--space-3) var(--space-6);
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  background: rgba(255, 255, 255, 0.76);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
  backdrop-filter: blur(8px);
}

.brand-wrap {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.eyebrow {
  margin: 0 0 var(--space-1);
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--secondary);
  font-weight: 700;
}

.site-nav ul {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
  list-style: none;
  margin: 0;
  padding: 0;
}

.site-nav a {
  display: inline-block;
  padding: var(--space-1) var(--space-2);
  border-radius: 999px;
  font-weight: 600;
  color: var(--primary);
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.site-nav a:hover,
.site-nav a:focus-visible {
  background: rgba(47, 111, 143, 0.1);
  transform: translateY(-1px);
}

.page-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  margin-top: var(--space-5);
}

.hero {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: var(--space-5);
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: clamp(var(--space-4), 5vw, var(--space-7));
}

.hero-copy {
  max-width: 620px;
}

.hero-copy p:last-of-type {
  max-width: 56ch;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 var(--space-3);
  border-radius: 999px;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.button:hover,
.button:focus-visible {
  transform: translateY(-2px);
}

.button.primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 12px 28px rgba(242, 140, 98, 0.28);
}

.button.secondary {
  background: rgba(30, 58, 95, 0.06);
  color: var(--primary);
}

.hero-panel {
  background: linear-gradient(135deg, var(--secondary) 0%, var(--primary) 100%);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  min-height: 280px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #fff;
  box-shadow: 0 18px 28px rgba(30, 58, 95, 0.2);
}

#spotlight {
  position: relative;
  overflow: hidden;
}

#spotlight::before {
  content: "";
  position: absolute;
  inset: -30% auto auto -10%;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.mini-card,
.mini-details {
  position: relative;
  z-index: 1;
}

.mini-card {
  display: inline-flex;
  flex-direction: column;
  gap: var(--space-1);
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  max-width: 210px;
}

.mini-card span {
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  opacity: 0.8;
}

.mini-card strong {
  font-size: 1.3rem;
}

.mini-details {
  max-width: 260px;
  font-size: 1rem;
}

.metrics-grid,
.project-grid {
  display: grid;
  gap: var(--space-4);
}

.metrics-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.metric,
.project-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  box-shadow: 0 12px 24px rgba(30, 58, 95, 0.05);
}

.metric-number {
  display: inline-block;
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 800;
  color: var(--accent);
  margin-bottom: var(--space-2);
}

.metric p,
.project-card p {
  color: var(--muted);
}

.feature-layout {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr;
  gap: var(--space-5);
  align-items: stretch;
}

.feature-copy,
.feature-quote {
  background: var(--surface-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: clamp(var(--space-3), 4vw, var(--space-5));
}

.feature-copy {
  background: rgba(255, 255, 255, 0.74);
}

.feature-quote {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--accent-soft) 0%, #fff6ef 100%);
}

.feature-quote p {
  margin: 0;
  font-size: clamp(1.2rem, 2vw, 1.7rem);
  color: var(--primary);
  font-family: "Playfair Display", Georgia, serif;
  line-height: 1.3;
}

.project-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.project-card {
  min-height: 220px;
}

.accent-card {
  background: linear-gradient(180deg, rgba(244, 185, 105, 0.12) 0%, rgba(255, 255, 255, 1) 100%);
}

.contact-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-3);
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: clamp(var(--space-3), 4vw, var(--space-5));
  box-shadow: var(--shadow);
}

.contact-banner .eyebrow {
  color: rgba(255, 255, 255, 0.8);
}

.contact-banner h2 {
  color: #fff;
  margin-bottom: 0;
}

.site-footer {
  padding: var(--space-3) 0 0;
  text-align: center;
  color: var(--muted);
}

@media (max-width: 767px) {
  .page-shell {
    padding: 16px 16px 32px;
  }

  .site-header,
  .hero,
  .feature-layout,
  .contact-banner {
    display: grid;
    grid-template-columns: 1fr;
  }

  .site-header {
    align-items: flex-start;
    padding: var(--space-3);
  }

  .site-nav ul {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero,
  .feature-layout,
  .project-grid,
  .metrics-grid {
    gap: var(--space-3);
  }

  .metrics-grid,
  .project-grid {
    grid-template-columns: 1fr;
  }

  .contact-banner {
    padding: var(--space-3);
  }
}

@media (min-width: 768px) and (max-width: 1199px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .feature-layout {
    grid-template-columns: 1fr;
  }

  .project-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 1200px) {
  .page-shell {
    padding-top: var(--space-5);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  a,
  .button {
    transition: none;
  }
}
